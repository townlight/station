  "components": {
    "schemas": {
      "AnalysisObservation": {
        "properties": {
          "source": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Source"
          },
          "filename": {
            "type": "string",
            "maxLength": 160,
            "title": "Filename",
            "default": ""
          },
          "media_type": {
            "type": "string",
            "maxLength": 80,
            "title": "Media Type",
            "default": ""
          },
          "text": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Text"
          },
          "adapter": {
            "type": "string",
            "maxLength": 120,
            "title": "Adapter",
            "default": ""
          },
          "citation_source_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Citation Source Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "text"
        ],
        "title": "AnalysisObservation",
        "description": "One draft observation, named with the adapter that actually produced it."
      },
      "AnalysisRecord": {
        "properties": {
          "observations": {
            "items": {
              "$ref": "#/components/schemas/AnalysisObservation"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Observations"
          },
          "cited_sections": {
            "items": {
              "$ref": "#/components/schemas/CitedSection"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Cited Sections"
          },
          "unavailable": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Unavailable"
          },
          "runtime": {
            "additionalProperties": true,
            "type": "object",
            "title": "Runtime"
          },
          "review_required": {
            "type": "boolean",
            "title": "Review Required",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "AnalysisRecord",
        "description": "The adapter output that accompanies a saved inspection draft."
      },
      "CitedSection": {
        "properties": {
          "source_id": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Source Id"
          },
          "citation": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Citation"
          },
          "title": {
            "type": "string",
            "maxLength": 500,
            "title": "Title",
            "default": ""
          },
          "version": {
            "type": "string",
            "maxLength": 80,
            "title": "Version",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "citation"
        ],
        "title": "CitedSection",
        "description": "One resolved public Code section; never a caller-supplied quotation."
      },
      "CodeLink": {
        "properties": {
          "provider": {
            "type": "string",
            "const": "code",
            "title": "Provider",
            "default": "code"
          },
          "source_id": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Source Id"
          },
          "expected_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Expected Sha256"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "expected_sha256"
        ],
        "title": "CodeLink"
      },
      "Evidence": {
        "properties": {
          "filename": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,150}$",
            "title": "Filename"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Description"
          },
          "media_type": {
            "type": "string",
            "enum": [
              "text/plain",
              "image/jpeg",
              "image/png",
              "image/webp",
              "application/pdf",
              "audio/webm",
              "audio/ogg",
              "audio/wav",
              "audio/mpeg",
              "audio/mp4"
            ],
            "title": "Media Type"
          },
          "content_base64": {
            "type": "string",
            "maxLength": 14000000,
            "minLength": 1,
            "title": "Content Base64"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Sha256"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "filename",
          "description",
          "media_type",
          "content_base64",
          "sha256"
        ],
        "title": "Evidence"
      },
      "EvidenceItem": {
        "properties": {
          "filename": {
            "type": "string",
            "maxLength": 151,
            "minLength": 1,
            "title": "Filename"
          },
          "media_type": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Media Type"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "title": "Description",
            "default": ""
          },
          "content_base64": {
            "type": "string",
            "maxLength": 14000000,
            "minLength": 1,
            "title": "Content Base64"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Sha256"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "filename",
          "media_type",
          "content_base64",
          "sha256"
        ],
        "title": "EvidenceItem"
      },
      "EvidenceItems": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/EvidenceItem"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items"
        ],
        "title": "EvidenceItems"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InspectionInput": {
        "properties": {
          "expected_revision": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Revision"
          },
          "title": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Title"
          },
          "property_reference": {
