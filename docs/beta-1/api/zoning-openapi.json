  "components": {
    "schemas": {
      "CodeContext": {
        "properties": {
          "section_number": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Section Number"
          },
          "as_of": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "section_number"
        ],
        "title": "CodeContext"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MeetingLink": {
        "properties": {
          "source_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Source Id"
          },
          "expected_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Expected Sha256"
          },
          "relation": {
            "type": "string",
            "enum": [
              "hearing",
              "context",
              "precedent"
            ],
            "title": "Relation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "expected_sha256",
          "relation"
        ],
        "title": "MeetingLink"
      },
      "MeetingSearch": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Query"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query"
        ],
        "title": "MeetingSearch"
      },
      "Outline": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Title"
          },
          "question_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Question Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "question_ids"
        ],
        "title": "Outline"
      },
      "Question": {
        "properties": {
          "jurisdiction": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Jurisdiction"
          },
          "query": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Query"
          },
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question"
          },
          "kind": {
            "type": "string",
            "enum": [
              "use",
              "dimension"
            ],
            "title": "Kind"
          },
          "key": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Key"
          },
          "audience": {
            "type": "string",
            "enum": [
              "resident",
              "staff"
            ],
            "title": "Audience",
            "default": "resident"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "jurisdiction",
          "query",
          "question",
          "kind",
          "key"
        ],
        "title": "Question"
      },
      "Review": {
        "properties": {
          "answer": {
            "type": "string",
            "maxLength": 10000,
            "title": "Answer",
            "default": ""
          },
          "notes": {
            "type": "string",
            "maxLength": 10000,
            "title": "Notes",
            "default": ""
          },
          "queue_status": {
            "type": "string",
            "enum": [
              "open",
              "in_review",
              "resolved",
              "closed"
            ],
            "title": "Queue Status",
            "default": "resolved"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Review"
      },
      "Rule": {
        "properties": {
          "jurisdiction": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Jurisdiction"
          },
          "zone_code": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Zone Code"
          },
          "key": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Key"
          },
          "section_number": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Section Number"
          },
          "kind": {
            "type": "string",
            "enum": [
              "use",
              "dimension"
            ],
            "title": "Kind"
          },
          "value": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Value"
          },
          "overlay_code": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255
              },
              {
