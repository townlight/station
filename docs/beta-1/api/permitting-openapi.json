  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IntakeInput": {
        "properties": {
          "expected_revision": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Revision"
          },
          "project_name": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Project Name"
          },
          "project_description": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Project Description"
          },
          "location": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Location"
          },
          "applicant_contact": {
            "type": "string",
            "maxLength": 2000,
            "title": "Applicant Contact",
            "default": ""
          },
          "requirement_revision": {
            "type": "string",
            "format": "uuid",
            "title": "Requirement Revision"
          },
          "materials": {
            "items": {
              "$ref": "#/components/schemas/MaterialReview"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Materials"
          },
          "linked_sources": {
            "items": {
              "$ref": "#/components/schemas/civicpermit__workflow_models__SourceLink"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Linked Sources"
          },
          "staff_notes": {
            "type": "string",
            "maxLength": 10000,
            "title": "Staff Notes",
            "default": ""
          },
          "assigned_to": {
            "type": "string",
            "maxLength": 255,
            "title": "Assigned To",
            "default": ""
          },
          "review_state": {
            "type": "string",
            "enum": [
              "draft",
              "follow_up",
              "reviewed"
            ],
            "title": "Review State",
            "default": "draft"
          },
          "review_notes": {
            "type": "string",
            "maxLength": 4000,
            "title": "Review Notes",
            "default": ""
          },
          "public_summary": {
            "type": "string",
            "maxLength": 10000,
            "title": "Public Summary",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "project_name",
          "project_description",
          "location",
          "requirement_revision",
          "materials"
        ],
        "title": "IntakeInput"
      },
      "Material": {
        "properties": {
          "material_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$",
            "title": "Material Id"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Description"
          },
          "citation": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Citation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "material_id",
          "description",
          "citation"
        ],
        "title": "Material"
      },
      "MaterialReview": {
        "properties": {
          "material_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Material Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "not_reviewed",
              "provided",
              "missing",
              "unclear"
            ],
            "title": "Status",
            "default": "not_reviewed"
          },
          "note": {
            "type": "string",
            "maxLength": 2000,
            "title": "Note",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "material_id"
        ],
        "title": "MaterialReview"
      },
      "Packet": {
        "properties": {
          "expected_revision": {
            "type": "string",
            "format": "uuid",
            "title": "Expected Revision"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "staff_only",
              "records_copy"
            ],
            "title": "Visibility"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision",
          "visibility"
        ],
        "title": "Packet"
      },
      "Pathway": {
        "properties": {
          "project_type": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Project Type"
          },
          "proposal": {
            "type": "string",
            "maxLength": 4000,
            "title": "Proposal",
            "default": ""
          },
          "location_context": {
            "type": "string",
            "maxLength": 1000,
            "title": "Location Context",
            "default": ""
          },
          "requirement_revision": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requirement Revision"
          },
          "fee_link": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/civicpermit__workflow_models__SourceLink"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "project_type"
        ],
        "title": "Pathway"
      },
      "PathwayStep": {
        "properties": {
          "step": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Step"
          },
          "citation": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Citation"
          },
          "typical_time": {
            "type": "string",
            "maxLength": 1000,
            "title": "Typical Time",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "step",
          "citation"
        ],
        "title": "PathwayStep"
      },
      "RequirementBundle": {
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$",
            "title": "Requirement Id"
          },
          "title": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Title"
          },
          "jurisdiction": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Jurisdiction"
          },
          "project_type": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Project Type"
          },
          "source_reference": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Source Reference"
          },
          "source_date": {
            "type": "string",
            "format": "date",
            "title": "Source Date"
          },
          "effective_on": {
            "type": "string",
            "format": "date",
            "title": "Effective On"
          },
          "dataset_kind": {
            "type": "string",
            "enum": [
              "municipal",
              "fictional"
            ],
            "title": "Dataset Kind"
          },
          "filename": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,150}$",
            "title": "Filename"
          },
          "content_base64": {
            "type": "string",
            "maxLength": 14000000,
            "minLength": 1,
            "title": "Content Base64"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Sha256"
          },
